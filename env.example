# ---------------------------------------------------------------------------
# Local / Vercel environment variables
# ---------------------------------------------------------------------------
# The values below are OPTIONAL. If they are omitted, the app falls back to the
# Firebase configuration stored in firebase-applet-config.json (which is safe
# to commit: Firebase web API keys are public identifiers, not secrets).
#
# Firebase / Cloud Firestore database
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""

# Server-side equivalents (used by the /api serverless functions on Vercel)
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_APP_ID=""
FIREBASE_DATABASE_ID=""

# GEMINI_API_KEY: Required for the Gemini AI assistant endpoint.
GEMINI_API_KEY=""

# APP_URL: Public URL of the deployment (e.g. https://your-app.vercel.app).
APP_URL=""

# ENABLE_BACKGROUND_REMINDERS: The in-process reminder engine is off unless this
# is exactly "true". Enable it only on a long-lived server that serves the live
# site; never on a developer machine or preview, where it would push real
# notifications to employees' phones while the code is being modified.
ENABLE_BACKGROUND_REMINDERS=""

# CRON_SECRET: Enables POST /api/push/cron/reminders, which lets an external
# scheduler (Vercel Cron or any uptime pinger) run the reminder engines while
# nobody has the website open. Send it as the x-cron-secret header.
CRON_SECRET=""

# WEB_PUSH_DISABLED: Set to "true" to suppress every outgoing push (staging,
# local testing, or demos). In-app notifications are still saved normally.
WEB_PUSH_DISABLED=""
